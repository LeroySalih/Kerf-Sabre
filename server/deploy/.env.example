# Public name of the server (DNS must point here). HTTPS certificates are fetched automatically.
KERF_DOMAIN=kerf.example.school

# People sign in with DINO (planner-004) only. REQUIRED: the server will not start without the issuer. See docs/AUTH-PLANNER-004.md.
# Roles come from DINO: admin, teacher, technician (runs the station pages, nothing else), pupil. Only the Cutter's station token is a stored token.
KERF_SSO_ISSUER=https://dino.example.school
# KERF_SSO_AUDIENCE=kerf-sabre
# KERF_SSO_CLIENT_EDITOR=kerf-editor
# KERF_SSO_CLIENT_ADMIN=kerf-admin

# Jobs wait for a teacher before they can be cut. Set to false to send submitted jobs straight to the stations.
KERF_REQUIRE_APPROVAL=true
# A job must be framed (laser off, to line up the material) on the station shortly before it can be cut there.
KERF_REQUIRE_FRAME=true
KERF_FRAME_VALID_MINUTES=30
# block: an open path on the Cut layer rejects the job. warn: it is cut as drawn, with a warning.
KERF_OPEN_CUT_PATHS=block
KERF_MAX_UPLOAD_MB=20

# Optional: PostgreSQL instead of the built-in SQLite file (pip install 'kerf-server[postgres]').
# KERF_DATABASE_URL=postgresql+psycopg://kerf:password@db/kerf
# Only needed if the Editor is served from a different address than the API.
# KERF_CORS_ORIGINS=https://editor.example.school
