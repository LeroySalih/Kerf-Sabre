{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kerf-sabre.local/schemas/job.schema.json",
  "title": "Job",
  "description": "A pupil's submitted design. Geometry in Design space (mm, Y-up); each object has an affine matrix placing it on the bed. No pupil names, pupil ID only.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "pupilId",
    "createdAt",
    "status",
    "preset",
    "origin",
    "objects"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "0.2.20"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "pupilId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Pupil ID, never a name"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "draft",
        "submitted",
        "approved",
        "queued",
        "assigned",
        "running",
        "done",
        "failed",
        "cancelled"
      ]
    },
    "preset": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "station": {
      "type": [
        "string",
        "null"
      ],
      "description": "Machine profile id once assigned"
    },
    "origin": {
      "type": "object",
      "required": [
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "absolute",
            "current-position"
          ]
        },
        "anchor": {
          "enum": [
            "top-left",
            "top-center",
            "top-right",
            "middle-left",
            "center",
            "middle-right",
            "bottom-left",
            "bottom-center",
            "bottom-right"
          ],
          "description": "Required when mode is current-position"
        }
      },
      "if": {
        "properties": {
          "mode": {
            "const": "current-position"
          }
        }
      },
      "then": {
        "required": [
          "anchor"
        ]
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/object"
      }
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "durationS": {
          "type": "number",
          "minimum": 0
        },
        "partAreaMm2": {
          "type": "number",
          "minimum": 0
        },
        "extentMm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["widthMm", "heightMm"],
          "properties": {
            "widthMm": { "type": "number", "minimum": 0 },
            "heightMm": { "type": "number", "minimum": 0 }
          },
          "description": "Size of the design (the box around everything that is cut or scored), not the bed. Before kerf compensation."
        },
        "sheetAreaUsedMm2": {
          "type": "number",
          "minimum": 0
        },
        "percentUsed": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "costSar": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "source": {
      "enum": [
        "editor",
        "dxf"
      ],
      "description": "Where the geometry came from. A DXF has been through the server clean-up pipeline."
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Non-blocking problems found when the job was accepted"
    },
    "activityId": {
      "type": ["string", "null"],
      "description": "The class activity this file is for. The server checks the pupil's class has it."
    },
    "ticket": {
      "type": ["integer", "null"],
      "description": "Queue ticket number, given when the job is approved. Numbers only go up and are never reused."
    },
    "dimensions": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/dimension"
      },
      "description": "Dimension annotations for people looking at the design. They are never cut, never turned into G-code and never sent to the Cutter."
    },
    "statusReason": {
      "type": "string",
      "description": "Why the job was rejected, cancelled or failed. Never contains a pupil name."
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "matrix": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 6,
      "maxItems": 6,
      "description": "Affine [a,b,c,d,e,f] Design -> Bed: x'=a*x+c*y+e, y'=b*x+d*y+f"
    },
    "segment": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "to"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "line"
            },
            "to": {
              "$ref": "#/$defs/point"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "to",
            "center",
            "clockwise"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "arc"
            },
            "to": {
              "$ref": "#/$defs/point"
            },
            "center": {
              "$ref": "#/$defs/point"
            },
            "clockwise": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "c1",
            "c2",
            "to"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "cubic"
            },
            "c1": {
              "$ref": "#/$defs/point"
            },
            "c2": {
              "$ref": "#/$defs/point"
            },
            "to": {
              "$ref": "#/$defs/point"
            }
          }
        }
      ]
    },
    "dimension": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "kind", "axis", "a", "b", "offsetMm"],
          "additionalProperties": false,
          "properties": {
            "id": {"type": "string"},
            "kind": {"const": "linear"},
            "axis": {"enum": ["aligned", "horizontal", "vertical"]},
            "a": {"$ref": "#/$defs/point"},
            "b": {"$ref": "#/$defs/point"},
            "offsetMm": {"type": "number", "description": "How far the dimension line sits from the measured points, to the left of a-to-b (aligned) or up/left of the points (horizontal/vertical)"}
          }
        },
        {
          "type": "object",
          "required": ["id", "kind", "center", "radiusMm", "angleRad", "diameter"],
          "additionalProperties": false,
          "properties": {
            "id": {"type": "string"},
            "kind": {"const": "radial"},
            "center": {"$ref": "#/$defs/point"},
            "radiusMm": {"type": "number", "exclusiveMinimum": 0},
            "angleRad": {"type": "number", "description": "Direction from the centre where the leader meets the circle"},
            "diameter": {"type": "boolean"}
          }
        }
      ]
    },
    "object": {
      "type": "object",
      "required": [
        "id",
        "layer",
        "closed",
        "start",
        "segments",
        "matrix"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "layer": {
          "enum": [
            "score",
            "cut",
            "ignore"
          ]
        },
        "closed": {
          "type": "boolean"
        },
        "start": {
          "$ref": "#/$defs/point"
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/segment"
          }
        },
        "matrix": {
          "$ref": "#/$defs/matrix"
        },
        "tabs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "atLengthMm",
              "widthMm"
            ],
            "additionalProperties": false,
            "properties": {
              "atLengthMm": {
                "type": "number",
                "minimum": 0
              },
              "widthMm": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "description": "Bridges left uncut on a closed Cut outline. atLengthMm is the distance of the tab centre along the outline in bed space (after the matrix), measured from the object's start point."
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "description": "Per-shape override of the material's settings for this object's layer, e.g. one cell of a material test grid.",
          "properties": {
            "powerPct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "speedMmPerS": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "passes": {
              "type": "integer",
              "minimum": 1
            },
            "dashMm": {
              "anyOf": [{"const": 0}, {"type": "number", "minimum": 0.1}],
              "description": "Dotted line: the length in mm of each dash and each gap along this object's path. 0 (default) is a solid line."
            }
          }
        }
      }
    }
  }
}
